---
import { url } from "../data/site";
---
<section class="film" aria-labelledby="film-title">
 <div class="wrap">
  <div class="top">
   <p class="label" data-perch="text">The launch film</p>
   <h2 class="h1" id="film-title" data-split data-perch="text">Forty-six seconds. <em>Every file.</em></h2>
  </div>
  <div class="stage" data-reveal>
   <!-- A little twig off the frame's corner, where the wren can rest. -->
   <span class="twig" aria-hidden="true" data-perch><i class="leaf"></i><i class="leaf two"></i></span>
   <figure class="frame" data-perch data-film>
    <video
     src={url("/film/paperwren.mp4")}
     poster={url("/film/paperwren-poster.jpg")}
     muted
     loop
     playsinline
     preload="metadata"
     disablepictureinpicture
     aria-label="Paperwren launch film: opening PDFs, documents, sheets and slides on Android and Windows"
    ></video>
    <span class="progress" aria-hidden="true"><i></i></span>
    <div class="controls">
     <button type="button" data-film-play aria-label="Pause film" aria-pressed="false">
      <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2" /><rect x="13.9" y="5" width="3.6" height="14" rx="1.2" /></svg>
      <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.9l10-6.4a1 1 0 0 0 0-1.8l-10-6.4A1 1 0 0 0 8 5.6z" /></svg>
     </button>
     <button type="button" data-film-sound aria-label="Unmute film" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="spk" d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path class="off" d="m16 9.5 5 5m0-5-5 5" /><path class="on" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" /></svg>
     </button>
    </div>
   </figure>
  </div>
 </div>
</section>
<style>
 /* Continues the hero's paper, so the film reads as the hero's second act. */
 .film { background: #c5c5b8; padding: clamp(1.5rem, 4vw, 3rem) 0 var(--section); }
 .top { display: grid; justify-items: center; gap: 1rem; text-align: center; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
 .stage { position: relative; width: min(100%, 1080px); margin: auto; }
 .frame { position: relative; margin: 0; border: 1px solid #606c5d; border-radius: 16px; overflow: hidden; background: #e6e0cf; box-shadow: 0 30px 60px #35442e24, 0 6px 14px #35442e14; aspect-ratio: 1216 / 656; }
 video { display: block; width: 100%; height: 100%; object-fit: cover; }
 video::-webkit-media-controls { display: none !important; }
 .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #f1eee41f; pointer-events: none; }
 .progress i { display: block; height: 100%; width: 100%; background: #d9e4c9; transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
 .controls { position: absolute; right: 16px; bottom: 16px; display: flex; gap: 8px; }
 .controls button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid #f1eee433; border-radius: 50%; background: #1f2e27b3; color: #f1eee4; cursor: pointer; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: background .25s, transform .4s var(--ease); }
 .controls button:hover { background: #294936; transform: translateY(-2px); }
 .controls button:focus-visible { outline: 2px solid #f1eee4; outline-offset: 3px; }
 .controls svg { width: 20px; height: 20px; }
 .play, .pause { fill: currentColor; }
 [data-film-play] .play, [data-film-play][aria-pressed="true"] .pause { display: none; }
 [data-film-play][aria-pressed="true"] .play { display: block; }
 [data-film-sound] svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
 [data-film-sound] .spk { fill: currentColor; }
 [data-film-sound] .on, [data-film-sound][aria-pressed="true"] .off { display: none; }
 [data-film-sound][aria-pressed="true"] .on { display: block; }
 /* A resting twig, planted in the frame's top-right corner. */
 .twig { position: absolute; z-index: 2; right: -34px; top: -5px; width: 128px; height: 7px; border-radius: 4px; background: linear-gradient(#8a7358, #5f4c38); rotate: -7deg; transform-origin: 10% 50%; box-shadow: 0 3px 5px #35442e30; }
 .twig::before { content: ""; position: absolute; right: 22px; top: -12px; width: 4px; height: 16px; border-radius: 3px; background: #6f5a43; rotate: 32deg; }
 .leaf { position: absolute; right: 8px; top: -13px; width: 16px; height: 9px; border-radius: 0 100% 0 100%; background: #6f8f64; rotate: -24deg; }
 .leaf.two { right: 58px; top: 5px; background: #5b7b52; rotate: 150deg; }
 @media (max-width: 600px) {
  .frame { border-radius: 12px; }
  .controls { right: 10px; bottom: 10px; gap: 6px; }
  .controls button { width: 38px; height: 38px; }
  .controls svg { width: 17px; height: 17px; }
  .twig { right: -6px; width: 96px; }
 }
</style>
<script>
 const frame = document.querySelector<HTMLElement>("[data-film]");
 const video = frame?.querySelector("video");
 const play = frame?.querySelector<HTMLButtonElement>("[data-film-play]");
 const sound = frame?.querySelector<HTMLButtonElement>("[data-film-sound]");
 if (frame && video && play && sound) {
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // A reader's pause sticks; otherwise the film plays whenever it is in view.
  let held = still, inView = false;
  const sync = () => {
   const paused = video.paused;
   play.setAttribute("aria-pressed", String(paused));
   play.setAttribute("aria-label", paused ? "Play film" : "Pause film");
   sound.setAttribute("aria-pressed", String(!video.muted));
   sound.setAttribute("aria-label", video.muted ? "Unmute film" : "Mute film");
  };
  const update = () => {
   if (inView && !held && !document.hidden) video.play().catch(() => { video.muted = true; video.play().catch(sync); });
   else video.pause();
  };
  new IntersectionObserver(([e]) => { inView = !!e && e.intersectionRatio >= .4; update(); }, { threshold: [0, .4] }).observe(frame);
  document.addEventListener("visibilitychange", update);
  play.addEventListener("click", () => { held = !video.paused; if (held) video.pause(); else { inView = true; update(); } });
  sound.addEventListener("click", () => { video.muted = !video.muted; if (!video.muted && video.paused) { held = false; update(); } sync(); });
  for (const type of ["play", "pause", "volumechange"]) video.addEventListener(type, sync);
  // No fullscreen or context menu: the film is part of the page.
  video.addEventListener("dblclick", e => e.preventDefault());
  video.addEventListener("contextmenu", e => e.preventDefault());
  const bar = frame.querySelector<HTMLElement>(".progress");
  video.addEventListener("timeupdate", () => { if (video.duration) bar?.style.setProperty("--p", String(video.currentTime / video.duration)); });
  sync();
 }
</script>
