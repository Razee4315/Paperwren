---
import { FAQ } from "../data/faq";
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
	<div class="wrap grid">
		<div>
			<p class="label">Questions</p>
			<h2 class="h1" id="faq-title" data-split>Fair <em>questions.</em></h2>
		</div>
		<div class="items">
			{
				FAQ.map((f) => (
					<details data-reveal>
						<summary>
							<span>{f.q}</span>
							<i aria-hidden="true" />
						</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 2rem clamp(2rem, 6vw, 6rem);
	}
	.grid .h1 {
		margin-top: 1.2rem;
	}
	.items {
		border-top: 1px solid var(--ink);
	}
	details {
		border-bottom: 1px solid var(--line);
	}
	summary {
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		padding: 1.3rem 0;
		cursor: pointer;
		font-family: var(--serif);
		font-size: var(--s-3);
		line-height: 1.2;
		transition: color 0.3s var(--ease);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover {
		color: var(--pine);
	}
	i {
		position: relative;
		flex: none;
		width: 18px;
		height: 18px;
	}
	i::before,
	i::after {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		width: 100%;
		height: 1.5px;
		background: currentColor;
		transition: transform 0.5s var(--ease);
	}
	i::after {
		transform: rotate(90deg);
	}
	details[open] i::after {
		transform: rotate(0deg);
	}
	details p {
		color: var(--ink-2);
		padding: 0 3rem 1.5rem 0;
		max-width: 40em;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
