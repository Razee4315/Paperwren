---
import Shot from "./Shot.astro";

// Colours are the app's own tokens (src/styles/global.css).
const themes = [
	{ id: "light", tex: "paper", name: "Paper", line: "Warm off-white with a faint paper fibre and a pine-teal accent. For daylight." },
	{ id: "sepia", tex: "sand", name: "Sand", line: "Low blue-light parchment with a fine sand grain and a terracotta accent. For long evenings." },
	{ id: "dark", tex: "ink", name: "Ink", line: "Soft charcoal, never pure black, with ink splatters in the corners and a mint accent. For the dark." },
];
const screens = [
	{ n: "home", alt: "home screen" },
	{ n: "view-docx", alt: "a Word document" },
	{ n: "settings", alt: "settings with the theme picker" },
];
---

<section class="themes" id="themes" data-tex="paper" data-theme="light" aria-labelledby="themes-title">
	<div class="wrap section">
		<div class="top">
			<div>
				<p class="label">Three calm themes</p>
				<h2 class="h1" id="themes-title" data-split>Easy on the eyes, <em>whenever</em> you read.</h2>
			</div>
			<div class="pick">
				<div class="buttons" role="group" aria-label="Preview a theme">
					{
						themes.map((t, i) => (
							<button type="button" data-pick={t.id} data-tex-id={t.tex} aria-pressed={i === 0 ? "true" : "false"}>
								<span class="dot" />
								{t.name}
							</button>
						))
					}
				</div>
				{
					themes.map((t, i) => (
						<p class="desc" data-desc={t.id} hidden={i !== 0}>
							{t.line}
						</p>
					))
				}
				<p class="auto">Or choose Auto: Paper by day, Ink at night.</p>
			</div>
		</div>

		<div class="stage">
			{
				themes.map((t, i) => (
					<div class="set" data-set={t.id} data-active={i === 0 ? "" : undefined}>
						{screens.map((s, k) => (
							<div class={`phone p${k}`}>
								<Shot name={`${t.id}-${s.n}`} alt={`Paperwren in the ${t.name} theme: ${s.alt}`} sizes="(max-width: 760px) 40vw, 300px" />
							</div>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.themes {
		--tex-bg: var(--t-bg);
		--t-bg: #f3f1ec;
		--t-text: #23221f;
		--t-text-2: #5b5952;
		--t-accent: #2b6e66;
		--t-line: #d9d4c9;
		background: var(--tex);
		background-color: var(--t-bg);
		color: var(--t-text);
		transition:
			background-color 0.7s var(--ease),
			color 0.7s var(--ease);
	}
	.themes[data-theme="sepia"] {
		--t-bg: #ede3d0;
		--t-text: #3a2e22;
		--t-text-2: #6a5a47;
		--t-accent: #a4502e;
		--t-line: #d3c2a5;
	}
	.themes[data-theme="dark"] {
		--t-bg: #16181b;
		--t-text: #e6e2da;
		--t-text-2: #aaa69e;
		--t-accent: #7cc2b4;
		--t-line: #3d4349;
	}
	.themes :global(.label),
	.desc,
	.auto {
		color: var(--t-text-2);
		transition: color 0.7s var(--ease);
	}
	.themes :global(h2 em) {
		color: var(--t-accent);
		transition: color 0.7s var(--ease);
	}
	.top {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 2rem 4rem;
		align-items: end;
	}
	.top .h1 {
		margin-top: 1.2rem;
	}
	.buttons {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	button {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.9rem;
		padding: 0 1.1rem;
		font: 600 0.95rem/1 var(--sans);
		color: var(--t-text);
		background: transparent;
		border: 1px solid var(--t-line);
		border-radius: var(--r);
		cursor: pointer;
		transition:
			border-color 0.3s var(--ease),
			background-color 0.3s var(--ease),
			transform 0.25s var(--ease);
	}
	button:hover {
		border-color: var(--t-text);
	}
	button:active {
		transform: scale(0.97);
	}
	button[aria-pressed="true"] {
		border-color: var(--t-accent);
		box-shadow: inset 0 0 0 1px var(--t-accent);
	}
	.dot {
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		border: 1px solid #00000033;
	}
	[data-pick="light"] .dot {
		background: #2b6e66;
	}
	[data-pick="sepia"] .dot {
		background: #a4502e;
	}
	[data-pick="dark"] .dot {
		background: #16181b;
		border-color: #7cc2b4;
	}
	.desc {
		margin-top: 1.1rem;
		min-height: 3.2em;
		max-width: 30em;
	}
	.auto {
		font: 400 0.8rem/1.4 var(--mono);
		margin-top: 0.8rem;
	}
	.stage {
		display: grid;
		margin-top: clamp(3rem, 6vw, 5rem);
	}
	.set {
		grid-area: 1 / 1;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 300px));
		justify-content: center;
		gap: clamp(0.8rem, 3vw, 3rem);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.6s var(--ease),
			visibility 0s linear 0.6s;
	}
	.set[data-active] {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.6s var(--ease);
	}
	.set .phone {
		transition: transform 0.9s var(--ease);
		transform: translateY(24px);
	}
	.set[data-active] .phone {
		transform: none;
	}
	.set[data-active] .p1 {
		transition-delay: 0.06s;
	}
	.set[data-active] .p2 {
		transition-delay: 0.12s;
	}
	.p1 {
		margin-top: 3rem;
	}
	@media (max-width: 860px) {
		.top {
			grid-template-columns: 1fr;
		}
		.set {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.6rem;
		}
		.p1 {
			margin-top: 1.5rem;
		}
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>("#themes");
	if (section) {
		const buttons = section.querySelectorAll<HTMLButtonElement>("[data-pick]");
		for (const b of buttons) {
			b.addEventListener("click", () => {
				const id = b.dataset.pick ?? "light";
				section.dataset.theme = id;
				section.dataset.tex = b.dataset.texId ?? "paper";
				for (const o of buttons) o.setAttribute("aria-pressed", String(o === b));
				for (const s of section.querySelectorAll<HTMLElement>("[data-set]")) {
					s.toggleAttribute("data-active", s.dataset.set === id);
				}
				for (const d of section.querySelectorAll<HTMLElement>("[data-desc]")) {
					d.hidden = d.dataset.desc !== id;
				}
			});
		}
	}
</script>
