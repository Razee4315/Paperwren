---
const groups = [
 { ext: "Documents", note: "Word, PDF, OpenDocument and RTF", detail: "Read reports, letters and notes.", formats: "PDF · DOCX · DOC · ODT · RTF" },
 { ext: "Spreadsheets", note: "Excel, OpenDocument and CSV", detail: "Browse tables and switch between sheets.", formats: "XLSX · XLS · ODS · CSV" },
 { ext: "Presentations", note: "PowerPoint and OpenDocument", detail: "Read slide decks and speaker notes.", formats: "PPTX · PPT · ODP" },
 { ext: "Text & code", note: "Markdown, plain text and JSON", detail: "Read notes, logs and formatted Markdown.", formats: "MD · TXT · JSON" },
];
import Shot from "./Shot.astro";

const phones = [
	{ shot: "light-view-pdf", ext: "PDF", title: "Lecture notes", alt: "A lecture PDF open in Paperwren with a diagram and headings", speed: "0.12" },
	{ shot: "light-view-docx", ext: "Word", title: "An invoice", alt: "A Word invoice shown in its own page layout", speed: "-0.1" },
	{ shot: "light-view-xlsx", ext: "Excel", title: "Site inventory", alt: "An Excel inventory sheet with frozen headers and sheet tabs", speed: "0.16" },
	{ shot: "light-view-pptx", ext: "PowerPoint", title: "A quarterly review", alt: "PowerPoint slides with a bar chart drawn from the deck's own shapes", speed: "-0.06" },
];
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
	<div class="wrap">
		<div class="top">
			<p class="label">What it opens</p>
			<h2 class="h1" id="formats-title" data-split>One app. <em>All the usual files.</em></h2>
			<p class="lede">
				Documents, sheets and slides, in their original layout.
			</p>
		</div>

		<div class="phones">
			{
				phones.map((p) => (
					<figure data-format-card>
						<div>
							<div class="phone">
								<Shot name={p.shot} alt={p.alt} sizes="(max-width: 760px) 62vw, 22vw" />
							</div>
						</div>
						<figcaption>
							<span class="label">{p.ext}</span>
							{p.title}
						</figcaption>
					</figure>
				))
			}
		</div>

		<div class="list">
			<p class="note" data-reveal>
				More than the big four.
			</p>
			<ul>
				{
					groups.map((f) => (
						<li data-reveal>
							<span class="ext">{f.ext}</span>
							<span class="what">{f.note}</span><details><summary>See formats</summary><p>{f.detail}</p><span class="extensions">{f.formats}</span></details>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
 .formats { padding-bottom: clamp(2.5rem, 4vw, 4rem); }
 details { margin-top: 8px; font-size: .8rem; color: var(--ink-2); }
 summary { cursor: pointer; width: fit-content; text-underline-offset: 4px; }
 summary:hover { color: var(--pine); }
 details p { margin: 12px 0 8px; }
 .extensions { font: .7rem/1.6 var(--mono); }

	.top {
		display: grid;
		gap: 1.2rem;
		max-width: 60rem;
	}
	.phones {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
        align-items: start;
		gap: clamp(1rem, 2.5vw, 2.5rem);
		margin: clamp(3rem, 7vw, 6rem) 0;
	}
 figure { transform-origin: 50% 50%; margin: 0; padding: 0 8px 12px; background: transparent; }
 figure .phone { max-width: 230px; margin: auto; }
 figure .phone:hover { translate: none; box-shadow: none; }
 figcaption { text-align: center; justify-items: center; padding-inline: 4px; }
 li { transition: background .25s, padding .25s; border-radius: 8px; }
 li:hover { background: #e8eee4; padding-left: 12px; }


	figcaption {
		display: grid;
		gap: 0.3rem;
		margin-top: 1.1rem;
		font-family: var(--serif);
		font-size: 1.15rem;
		line-height: 1.4;
	}
	.list {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: clamp(2rem, 5vw, 5rem);
		border-top: 1px solid var(--ink);
		padding-top: 2rem;
	}
	.note {
		font-family: var(--serif);
		font-size: var(--s-3);
		line-height: 1.3;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 2.5rem;
	}
	li {
		display: grid;
		gap: 0.15rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--line);
	}
	.ext {
		font: 700 1.05rem/1.4 var(--sans);
		letter-spacing: 0.04em;
	}
	.what {
		color: var(--ink-2);
		font-size: var(--s-small);
	}
	@media (max-width: 860px) {
		.phones {
			grid-template-columns: repeat(4, 62vw);
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			margin-inline: calc(-1 * var(--gutter));
			padding-inline: var(--gutter);
			scrollbar-width: none;
		}
		figure {
			scroll-snap-align: center;
		}
		figure:nth-child(even) {
			margin-top: 0;
		}
		.list,
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
