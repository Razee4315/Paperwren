---
const facts = [
 { value: "0", label: "Accounts", detail: "Open and read." },
 { value: "0", label: "Ads", detail: "No interruptions." },
 { value: "0", label: "Uploads", detail: "Files stay with you." },
 { value: "0", label: "Cost", detail: "Free. Open source." },
];
---
<section class="essentials" aria-label="No accounts, ads, uploads or cost">
 <div class="wrap"><dl>{facts.map(f => <div class="fact"><dt>{f.label}</dt><dd class="number">{f.value}<span aria-hidden="true">.</span></dd><dd class="detail">{f.detail}</dd></div>)}</dl></div>
</section>
<style>
 .essentials { padding-block: 48px; background: #bac3ae; }
 dl { margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
 .fact { display: flex; flex-direction: column; padding: 8px 32px; border-right: 1px solid #8e9b81; }
 .fact:first-child { padding-left: 0; } .fact:last-child { border: 0; }
 .number { order: -1; margin: 0 0 12px; font-size: 3rem; line-height: 1.1; font-weight: 550; letter-spacing: -.06em; }
 dd span { color: #6c815f; } dt { font-weight: 700; font-size: .95rem; } .detail { font-size: .8rem; font-weight: 400; letter-spacing: 0; line-height: 1.6; color: #45503e; margin: 4px 0 0; }
 @media(max-width: 600px) { dl { grid-template-columns: 1fr 1fr; gap: 28px 0; } .fact { display: flex; flex-direction: column; padding: 0 20px; } .fact:nth-child(odd) { padding-left: 0; } .fact:nth-child(even) { border: 0; } }
</style>
