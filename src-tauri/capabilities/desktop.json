{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop-capability",
	"description": "Desktop document viewer. Only the IPC commands used by the web layer are allowed. File reads keep the existing broad scope for picked files, drag-and-drop, adjacent pictures and recents from previous sessions; WebView data remains denied. Folder metadata uses stat and read-dir. Rust handles window restoration, native save dialogs and validated save/rename commands without frontend plugin permissions. Window controls, fullscreen, theme background, macOS menus/printing and desktop update/restart retain their required commands.",
	"platforms": ["windows", "macOS", "linux"],
	"windows": ["main"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"core:window:allow-inner-size",
		"core:window:allow-outer-position",
		"core:window:allow-is-fullscreen",
		"core:window:allow-is-minimized",
		"core:window:allow-is-maximized",
		"core:window:allow-internal-toggle-maximize",
		"core:menu:allow-new",
		"core:menu:allow-set-enabled",
		"core:menu:allow-set-as-app-menu",
		"core:menu:allow-set-as-windows-menu-for-nsapp",
		"core:resources:allow-close",
		"core:window:allow-set-title",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"core:window:allow-start-dragging",
		"core:window:allow-set-fullscreen",
		"core:window:allow-set-background-color",
		"core:webview:allow-print",
		"dialog:allow-open",
		"updater:allow-check",
		"updater:allow-download-and-install",
		"process:allow-restart",
		"fs:deny-webview-data-linux",
		"fs:deny-webview-data-windows",
		{
			"identifier": "fs:allow-read-file",
			"allow": [
				{
					"path": "**"
				},
				{
					"path": "**/*"
				}
			]
		},
		{
			"identifier": "fs:allow-stat",
			"allow": [
				{
					"path": "**"
				},
				{
					"path": "**/*"
				}
			]
		},
		{
			"identifier": "fs:allow-read-dir",
			"allow": [
				{
					"path": "**"
				},
				{
					"path": "**/*"
				}
			]
		}
	]
}
