{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop-capability",
	"description": "Desktop windows. Paperwren is a viewer: the fs plugin gets read-only access so picked files can be read. No write, no network permissions.",
	"platforms": ["windows", "macOS", "linux"],
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:window:default",
		"core:app:default",
		"dialog:default",
		"dialog:allow-open",
		{
			"identifier": "fs:default",
			"allow": [{ "path": "**" }, { "path": "**/*" }]
		},
		{
			"identifier": "fs:allow-read-file",
			"allow": [{ "path": "**" }, { "path": "**/*" }]
		}
	]
}
